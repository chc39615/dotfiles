# Source the base configuration
source ~/.zsh/env.zsh
# file colors for eza + zsh completion/fzf-tab (generated once by `vivid generate tokyonight-storm`)
source ~/.zsh/ls_colors.zsh
source ~/.zsh/options.zsh
source ~/.zsh/completion.zsh
source ~/.zsh/alias.zsh


# Source plugin configurations
source ~/.zsh/plugins/antidote.zsh
source ~/.zsh/plugins/zoxide.zsh
source ~/.zsh/plugins/startship.zsh
source ~/.zsh/plugins/eza.zsh
source ~/.zsh/plugins/fzf.zsh

